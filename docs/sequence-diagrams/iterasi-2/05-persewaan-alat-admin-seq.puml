@startuml persewaan-admin-approve
title Persewaan Alat - Admin: Approve Order

actor Admin
participant "EquipmentRentalRequestController" as AdminController
participant "Order" as OrderModel
participant "IncomeService" as IncomeService
participant "MailService" as Mail

Admin -> AdminController: approve($orderId)
AdminController -> OrderModel: find($orderId)
OrderModel --> AdminController: Order
AdminController -> OrderModel: updateStatus('approved')
OrderModel --> AdminController: updated
AdminController -> IncomeService: createFromOrder(Order)
IncomeService --> AdminController: Income(id)
AdminController -> Mail: queue(OrderStatusMail::approved, Order)
AdminController --> Admin: 200 OK

@enduml

@startuml persewaan-admin-reject
title Persewaan Alat - Admin: Reject Order

actor Admin
participant "EquipmentRentalRequestController" as AdminController
participant "Order" as OrderModel
participant "MailService" as Mail

Admin -> AdminController: reject($orderId, $reason)
AdminController -> OrderModel: find($orderId)
OrderModel --> AdminController: Order
AdminController -> OrderModel: updateStatus('rejected')
OrderModel --> AdminController: updated
AdminController -> Mail: queue(OrderStatusMail::rejected, Order)
AdminController --> Admin: 200 OK

@enduml

